<section class="sg-section sg-collections" id="sg-collections-{{ section.id }}">
  <div class="sg-shell-width">
    <header class="sg-section-heading">
      {%- if section.settings.eyebrow != blank -%}<p class="sg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.description != blank -%}<p class="sg-section-heading__description">{{ section.settings.description | escape }}</p>{%- endif -%}
    </header>

    {%- if section.settings.collections != blank -%}
      <div class="sg-collection-grid">
        {%- for collection in section.settings.collections -%}
          {%- liquid
            assign sg_collection_image = collection.featured_image | default: collection.image
            if sg_collection_image == blank and collection.products_count > 0
              assign sg_first_product = collection.products.first
              assign sg_collection_image = sg_first_product.featured_image
            endif
          -%}
          <a class="sg-collection-card" href="{{ collection.url }}">
            <span class="sg-collection-card__media">
              {%- if sg_collection_image != blank -%}
                {{ sg_collection_image | image_url: width: 900 | image_tag: class: 'sg-collection-card__image', widths: '360, 540, 720, 900', sizes: '(min-width: 1100px) 23vw, (min-width: 600px) 46vw, 92vw', loading: 'lazy', alt: collection.title }}
              {%- else -%}
                <span class="sg-collection-card__placeholder" aria-hidden="true">{% render 'sg-icon', name: 'gift' %}</span>
              {%- endif -%}
              <span class="sg-collection-card__arrow" aria-hidden="true">{% render 'sg-icon', name: 'arrow' %}</span>
            </span>
            <span class="sg-collection-card__meta">
              <span class="sg-collection-card__title">{{ collection.title | escape }}</span>
              {%- if section.settings.show_product_count -%}<span class="sg-collection-card__count">{{ collection.products_count }} gifts</span>{%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="sg-empty-state">
        <span class="sg-empty-state__icon">{% render 'sg-icon', name: 'gift' %}</span>
        <p>{{ section.settings.empty_message | escape }}</p>
      </div>
    {%- endif -%}

    {%- if section.settings.show_all_link and section.settings.all_link != blank -%}
      <div class="sg-section__action">
        <a class="sg-button sg-button--outline" href="{{ section.settings.all_link }}">{{ section.settings.all_link_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SG · Collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore Our Collections" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Handpicked gifting options for every function, family and guest." },
    { "type": "collection_list", "id": "collections", "label": "Collections to feature", "limit": 8, "info": "Select real Shopify collections to show here." },
    { "type": "checkbox", "id": "show_product_count", "label": "Show gift count", "default": false },
    { "type": "checkbox", "id": "show_all_link", "label": "Show all collections link", "default": true },
    { "type": "text", "id": "all_link_label", "label": "All collections button", "default": "View All Collections" },
    { "type": "url", "id": "all_link", "label": "All collections link" },
    { "type": "text", "id": "empty_message", "label": "Empty state message", "default": "Explore thoughtful gifting for every function, family and guest. More collections are being added soon." }
  ],
  "presets": [{ "name": "SG · Collections" }]
}
{% endschema %}
