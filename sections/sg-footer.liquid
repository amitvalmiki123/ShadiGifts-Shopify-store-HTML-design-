{%- liquid
  assign sg_phone_digits = section.settings.phone_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign sg_collection_links = 'return-gifts:Return Gifts,welcome-hampers:Welcome Hampers,vip-family-gifts:VIP & Family Gifts,bridal-party-gifts:Bridal Party Gifts,function-gifts:Function Gifts,trousseau-packing:Trousseau Packing' | split: ','
-%}
<footer class="sg-site-footer" role="contentinfo" {{ section.shopify_attributes }}>
  <div class="sg-shell-width sg-site-footer__grid">
    <div class="sg-site-footer__brand-column">
      <a class="sg-brand sg-brand--footer" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | escape }} home">
        {% render 'sg-brand-mark' %}
        <span class="sg-brand__text">
          <strong>{{ section.settings.brand_name | escape }}</strong>
          <small>{{ section.settings.brand_tagline | escape }}</small>
        </span>
      </a>
      <p class="sg-site-footer__description">{{ section.settings.description | escape }}</p>
    </div>

    <div class="sg-site-footer__column">
      <h2 class="sg-site-footer__heading">{{ section.settings.explore_heading | escape }}</h2>
      <ul role="list">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="{{ routes.collections_url }}">Collections</a></li>
        <li><a href="/pages/services">Services</a></li>
        <li><a href="/pages/planner">Wedding Gifting Planner</a></li>
        <li><a href="/pages/about">About Us</a></li>
      </ul>
    </div>

    <div class="sg-site-footer__column">
      <h2 class="sg-site-footer__heading">{{ section.settings.collections_heading | escape }}</h2>
      <ul role="list">
        {%- for sg_item in sg_collection_links -%}
          {%- assign sg_parts = sg_item | split: ':' -%}
          <li><a href="{{ routes.collections_url }}/{{ sg_parts[0] }}">{{ sg_parts[1] | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="sg-site-footer__column sg-site-footer__contact">
      <h2 class="sg-site-footer__heading">{{ section.settings.contact_heading | escape }}</h2>
      <ul role="list">
        <li><a href="tel:+{{ sg_phone_digits | escape }}">{{ section.settings.phone_display | escape }}</a></li>
        <li><a href="https://wa.me/{{ sg_phone_digits | escape }}" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a></li>
        <li><a href="/pages/wishlist">My Wishlist (<span data-sg-wishlist-count>0</span>)</a></li>
      </ul>
      <p class="sg-site-footer__note">{{ section.settings.no_purchase_note | escape }}</p>
    </div>
  </div>

  <div class="sg-site-footer__copyright">
    <div class="sg-shell-width">© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | escape }}. {{ section.settings.copyright_text | escape }}</div>
  </div>
</footer>

{% schema %}
{
  "name": "SG · Brand footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "ShaadiGifts" },
    { "type": "text", "id": "brand_tagline", "label": "Brand tagline", "default": "The Wedding Gifting Concierge" },
    { "type": "textarea", "id": "description", "label": "Brand description", "default": "We curate, personalize, package and deliver your wedding gifts — on time, at your venue, anywhere in the world." },
    { "type": "text", "id": "explore_heading", "label": "Explore column heading", "default": "Explore" },
    { "type": "text", "id": "collections_heading", "label": "Collections column heading", "default": "Collections" },
    { "type": "text", "id": "contact_heading", "label": "Contact column heading", "default": "Get in Touch" },
    { "type": "text", "id": "phone_display", "label": "Phone number shown", "default": "+91 98765 43210" },
    { "type": "text", "id": "phone_number", "label": "Phone number for links (country code and digits)", "default": "919876543210" },
    { "type": "textarea", "id": "no_purchase_note", "label": "Concierge note", "default": "Gifts are not sold online — build a wishlist and request a personalised proposal." },
    { "type": "text", "id": "copyright_text", "label": "Copyright ending", "default": "All rights reserved." }
  ],
  "presets": [
    { "name": "SG · Brand footer" }
  ]
}
{% endschema %}
