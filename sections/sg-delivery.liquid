<section class="sg-section sg-delivery" id="sg-delivery-{{ section.id }}">
  <div class="sg-shell-width sg-two-column sg-two-column--delivery">
    <div class="sg-delivery__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="sg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <p class="sg-delivery__lead">{{ section.settings.description | escape }}</p>
      {%- if section.blocks.size > 0 -%}
        <ul class="sg-check-list" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span class="sg-check-list__icon">{% render 'sg-icon', name: 'check' %}</span>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.note != blank -%}<p class="sg-delivery__note">{{ section.settings.note | escape }}</p>{%- endif -%}
      {%- if section.settings.button_link != blank -%}
        <a class="sg-button sg-button--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} {% render 'sg-icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="sg-delivery__media">
      {%- if section.settings.image != blank -%}
        {%- assign sg_delivery_alt = section.settings.image_alt | default: section.settings.image.alt | default: 'A wedding gift prepared for delivery' -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'sg-delivery__image', widths: '500, 700, 1000, 1400', sizes: '(min-width: 900px) 48vw, 100vw', loading: 'lazy', alt: sg_delivery_alt }}
      {%- else -%}
        <div class="sg-delivery__placeholder" role="img" aria-label="Add a delivery photograph in the theme editor">
          <span class="sg-delivery__placeholder-orbit sg-delivery__placeholder-orbit--one"></span>
          <span class="sg-delivery__placeholder-orbit sg-delivery__placeholder-orbit--two"></span>
          <div class="sg-delivery__gift-box"><span class="sg-delivery__gift-ribbon"></span><span class="sg-delivery__gift-bow"></span><span class="sg-delivery__gift-label">With love</span></div>
          <span class="sg-delivery__stamp">Delivered<br>with care</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SG · Delivery",
  "max_blocks": 5,
  "blocks": [
    { "type": "point", "name": "Delivery detail", "settings": [
      { "type": "text", "id": "text", "label": "Detail", "default": "Delivery to your home, hotel, resort or wedding venue" }
    ] }
  ],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Delivery photograph" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Delivery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On Time, At Your Venue — Anywhere In The World" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Wedding gifting runs on a schedule. We work backwards from your function dates so every box reaches the right place before it is needed." },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Share your wedding date and venue in the planner and we will confirm timelines in your proposal." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Check My Wedding Dates" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "SG · Delivery", "blocks": [
    { "type": "point", "settings": { "text": "Delivery to your home, hotel, resort or wedding venue" } },
    { "type": "point", "settings": { "text": "Planned around your functions — Haldi to Reception" } },
    { "type": "point", "settings": { "text": "Seamless delivery across India and international locations" } },
    { "type": "point", "settings": { "text": "Regular updates from your dedicated concierge" } }
  ] }]
}
{% endschema %}
