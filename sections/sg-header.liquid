{%- liquid
  assign sg_collection_links = 'return-gifts:Return Gifts,welcome-hampers:Welcome Hampers,vip-family-gifts:VIP & Family Gifts,bridal-party-gifts:Bridal Party Gifts,function-gifts:Function Gifts,trousseau-packing:Trousseau Packing' | split: ','
  assign sg_price_url = routes.collections_url | append: '/all?filter.v.price.gte=100&filter.v.price.lte=999'
-%}
<header class="sg-site-header" data-sg-site-header {{ section.shopify_attributes }}>
  <div class="sg-shell-width sg-site-header__inner">
    <a class="sg-brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | escape }} home">
      {% render 'sg-brand-mark' %}
      <span class="sg-brand__text">
        <strong>{{ section.settings.brand_name | escape }}</strong>
        <small>{{ section.settings.brand_tagline | escape }}</small>
      </span>
    </a>

    <nav class="sg-site-header__nav" aria-label="Primary navigation">
      <ul class="sg-site-header__nav-list" role="list">
        <li>
          <a class="sg-nav-link{% if request.page_type == 'index' %} is-current{% endif %}" href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>Home</a>
        </li>
        <li>
          <details class="sg-nav-dropdown{% if request.page_type == 'collection' or request.page_type == 'list-collections' %} is-current{% endif %}">
            <summary class="sg-nav-link" aria-label="Collections, open menu">
              <span>Collections</span>
              {% render 'sg-icon', name: 'chevron' %}
            </summary>
            <div class="sg-nav-dropdown__panel">
              <a class="sg-nav-dropdown__all" href="{{ routes.collections_url }}">All Collections</a>
              {%- for sg_item in sg_collection_links -%}
                {%- assign sg_parts = sg_item | split: ':' -%}
                <a href="{{ routes.collections_url }}/{{ sg_parts[0] }}">{{ sg_parts[1] | escape }}</a>
              {%- endfor -%}
            </div>
          </details>
        </li>
        <li>
          <a class="sg-nav-link{% if request.path contains '/pages/services' %} is-current{% endif %}" href="/pages/services"{% if request.path contains '/pages/services' %} aria-current="page"{% endif %}>Services</a>
        </li>
        <li>
          <a class="sg-nav-link{% if request.path contains '/pages/planner' %} is-current{% endif %}" href="/pages/planner"{% if request.path contains '/pages/planner' %} aria-current="page"{% endif %}>Wedding Gifting Planner</a>
        </li>
        <li>
          <a class="sg-nav-link{% if request.path contains '/pages/about' %} is-current{% endif %}" href="/pages/about"{% if request.path contains '/pages/about' %} aria-current="page"{% endif %}>About Us</a>
        </li>
      </ul>
    </nav>

    <div class="sg-site-header__actions" role="group" aria-label="Quick links">
      <a class="sg-price-chip" href="{{ sg_price_url }}" aria-label="Browse wedding gifts priced from 100 to 999 rupees">
        <span class="sg-price-chip__icon">{% render 'sg-icon', name: 'tag' %}</span>
        <span>{{ section.settings.price_label | escape }}</span>
      </a>
      <a class="sg-wishlist-pill" href="/pages/wishlist">
        {% render 'sg-icon', name: 'heart' %}
        <span>{{ section.settings.wishlist_label | escape }} (<span data-sg-wishlist-count>0</span>)</span>
      </a>
      <a class="sg-button sg-button--primary sg-button--small sg-header-planner" href="/pages/planner">
        <span>{{ section.settings.planner_label | escape }}</span>
        {% render 'sg-icon', name: 'arrow' %}
      </a>
    </div>

    <div class="sg-site-header__mobile-actions">
      <a class="sg-wishlist-mini" href="/pages/wishlist" aria-label="Wishlist">
        {% render 'sg-icon', name: 'heart' %}
        <span class="sg-wishlist-mini__count" data-sg-wishlist-count>0</span>
      </a>
      <button class="sg-menu-trigger" type="button" aria-label="Open navigation menu" aria-haspopup="dialog" aria-controls="sg-header-drawer-{{ section.id }}" data-sg-menu-open>
        {% render 'sg-icon', name: 'menu' %}
      </button>
    </div>
  </div>

  <dialog class="sg-mobile-drawer" id="sg-header-drawer-{{ section.id }}" aria-label="Mobile navigation" data-sg-header-drawer>
    <div class="sg-mobile-drawer__panel">
      <div class="sg-mobile-drawer__top">
        <span class="sg-mobile-drawer__title">Menu</span>
        <button class="sg-mobile-drawer__close" type="button" aria-label="Close navigation menu" data-sg-menu-close>
          {% render 'sg-icon', name: 'close' %}
        </button>
      </div>
      <nav class="sg-mobile-drawer__nav" aria-label="Mobile navigation">
        <a class="sg-mobile-drawer__link{% if request.page_type == 'index' %} is-current{% endif %}" href="{{ routes.root_url }}">Home</a>
        <details class="sg-mobile-drawer__dropdown">
          <summary class="sg-mobile-drawer__link">
            <span>Collections</span>
            {% render 'sg-icon', name: 'chevron' %}
          </summary>
          <div class="sg-mobile-drawer__subnav">
            <a href="{{ routes.collections_url }}">All Collections</a>
            {%- for sg_item in sg_collection_links -%}
              {%- assign sg_parts = sg_item | split: ':' -%}
              <a href="{{ routes.collections_url }}/{{ sg_parts[0] }}">{{ sg_parts[1] | escape }}</a>
            {%- endfor -%}
          </div>
        </details>
        <a class="sg-mobile-drawer__link{% if request.path contains '/pages/services' %} is-current{% endif %}" href="/pages/services">Services</a>
        <a class="sg-mobile-drawer__link{% if request.path contains '/pages/planner' %} is-current{% endif %}" href="/pages/planner">Wedding Gifting Planner</a>
        <a class="sg-mobile-drawer__link{% if request.path contains '/pages/about' %} is-current{% endif %}" href="/pages/about">About Us</a>
        <a class="sg-mobile-drawer__link" href="/pages/wishlist">{{ section.settings.wishlist_label | escape }} (<span data-sg-wishlist-count>0</span>)</a>
        <a class="sg-mobile-drawer__price" href="{{ sg_price_url }}">
          <span class="sg-price-chip__icon">{% render 'sg-icon', name: 'tag' %}</span>
          {{ section.settings.price_label | escape }}
        </a>
        <a class="sg-button sg-button--primary sg-mobile-drawer__planner" href="/pages/planner">
          <span>{{ section.settings.planner_label | escape }}</span>
          {% render 'sg-icon', name: 'arrow' %}
        </a>
      </nav>
    </div>
  </dialog>
</header>

{% schema %}
{
  "name": "SG · Brand header",
  "class": "header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "ShaadiGifts" },
    { "type": "text", "id": "brand_tagline", "label": "Brand tagline", "default": "The Wedding Gifting Concierge" },
    { "type": "text", "id": "price_label", "label": "Price range chip", "default": "₹100 – ₹999" },
    { "type": "text", "id": "wishlist_label", "label": "Wishlist link label", "default": "Wishlist" },
    { "type": "text", "id": "planner_label", "label": "Planner button label", "default": "Plan My Wedding Gifting" }
  ],
  "presets": [
    { "name": "SG · Brand header" }
  ]
}
{% endschema %}
