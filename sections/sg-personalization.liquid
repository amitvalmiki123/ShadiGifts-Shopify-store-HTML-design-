<section class="sg-section sg-section--band sg-personalization" id="sg-personalization-{{ section.id }}">
  <div class="sg-shell-width sg-two-column">
    <div class="sg-personalization__collage" aria-label="Personalisation and packaging examples">
      <div class="sg-personalization__image sg-personalization__image--one">
        {%- if section.settings.image_1 != blank -%}
          {%- assign sg_alt_1 = section.settings.image_alt_1 | default: section.settings.image_1.alt | default: 'Keepsake wedding gift box' -%}
          {{ section.settings.image_1 | image_url: width: 900 | image_tag: class: 'sg-personalization__photo', widths: '320, 480, 700, 900', loading: 'lazy', alt: sg_alt_1 }}
        {%- else -%}<img class="sg-personalization__photo" src="{{ 'sg-personalization-royal-box.jpg' | asset_url }}" alt="Teal and gold gift box with ribbon" width="337" height="166" loading="lazy">{%- endif -%}
      </div>
      <div class="sg-personalization__image sg-personalization__image--two">
        {%- if section.settings.image_2 != blank -%}
          {%- assign sg_alt_2 = section.settings.image_alt_2 | default: section.settings.image_2.alt | default: 'Hand-finished wedding gift jars' -%}
          {{ section.settings.image_2 | image_url: width: 900 | image_tag: class: 'sg-personalization__photo', widths: '320, 480, 700, 900', loading: 'lazy', alt: sg_alt_2 }}
        {%- else -%}<img class="sg-personalization__photo" src="{{ 'sg-personalization-tea-jars.jpg' | asset_url }}" alt="Hand-painted floral jars with gold lids" width="337" height="166" loading="lazy">{%- endif -%}
      </div>
      <div class="sg-personalization__image sg-personalization__image--three">
        {%- if section.settings.image_3 != blank -%}
          {%- assign sg_alt_3 = section.settings.image_alt_3 | default: section.settings.image_3.alt | default: 'Embroidered wedding favour bag' -%}
          {{ section.settings.image_3 | image_url: width: 900 | image_tag: class: 'sg-personalization__photo', widths: '320, 480, 700, 900', loading: 'lazy', alt: sg_alt_3 }}
        {%- else -%}<img class="sg-personalization__photo" src="{{ 'sg-personalization-potli.jpg' | asset_url }}" alt="Embroidered potli bags" width="337" height="178" loading="lazy">{%- endif -%}
      </div>
      <div class="sg-personalization__image sg-personalization__image--four">
        {%- if section.settings.image_4 != blank -%}
          {%- assign sg_alt_4 = section.settings.image_alt_4 | default: section.settings.image_4.alt | default: 'Wedding welcome hamper' -%}
          {{ section.settings.image_4 | image_url: width: 900 | image_tag: class: 'sg-personalization__photo', widths: '320, 480, 700, 900', loading: 'lazy', alt: sg_alt_4 }}
        {%- else -%}<img class="sg-personalization__photo" src="{{ 'sg-personalization-candle-holder.jpg' | asset_url }}" alt="Golden cut-work candle holder" width="337" height="166" loading="lazy">{%- endif -%}
      </div>
    </div>

    <div class="sg-personalization__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="sg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <p class="sg-personalization__lead">{{ section.settings.description | escape }}</p>
      {%- if section.blocks.size > 0 -%}
        <ul class="sg-check-list" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span class="sg-check-list__icon">{% render 'sg-icon', name: 'check' %}</span>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_button and section.settings.button_link != blank -%}
        <a class="sg-button sg-button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SG · Personalisation",
  "max_blocks": 5,
  "blocks": [
    { "type": "detail", "name": "Personalisation detail", "settings": [
      { "type": "text", "id": "text", "label": "Detail", "default": "Names, initials and monograms on boxes, tags and bags" }
    ] }
  ],
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Collage image 1" },
    { "type": "text", "id": "image_alt_1", "label": "Image 1 alt text" },
    { "type": "image_picker", "id": "image_2", "label": "Collage image 2" },
    { "type": "text", "id": "image_alt_2", "label": "Image 2 alt text" },
    { "type": "image_picker", "id": "image_3", "label": "Collage image 3" },
    { "type": "text", "id": "image_alt_3", "label": "Image 3 alt text" },
    { "type": "image_picker", "id": "image_4", "label": "Collage image 4" },
    { "type": "text", "id": "image_alt_4", "label": "Image 4 alt text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personalization & Packaging" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make Every Gift Unmistakably Yours" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "A gift feels special when it looks like it belongs to your wedding. We add the details that guests remember — and keep them consistent from the welcome hamper to the farewell box." },
    { "type": "checkbox", "id": "show_button", "label": "Show services button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Our Services" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "SG · Personalisation", "blocks": [
    { "type": "detail", "settings": { "text": "Names, initials and monograms on boxes, tags and bags" } },
    { "type": "detail", "settings": { "text": "Custom message cards and handwritten-style notes" } },
    { "type": "detail", "settings": { "text": "Theme and colour matching — ribbons, wraps and trays" } },
    { "type": "detail", "settings": { "text": "Separate packing for VIP, family, bridal party and guests" } },
    { "type": "detail", "settings": { "text": "Trousseau and sweets packing for the families" } }
  ] }]
}
{% endschema %}
