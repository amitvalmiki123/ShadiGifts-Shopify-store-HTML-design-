{%- liquid
  assign sg_featured_collection = section.settings.collection
  assign sg_wishlist_url = section.settings.wishlist_link
-%}

{%- capture sg_featured_cards -%}
  {%- if sg_featured_collection != blank -%}
    {%- for product in sg_featured_collection.products limit: section.settings.products_to_show -%}
      {%- if product != blank and product.id != blank and product.title != blank and product.url != blank -%}
        {%- assign sg_product_image = product.featured_image -%}
        {%- if sg_product_image == blank -%}
          {%- assign sg_product_image = product.featured_media.preview_image -%}
        {%- endif -%}
        {%- if sg_product_image == blank -%}
          {%- assign sg_product_image = product.images.first -%}
        {%- endif -%}
        {%- if sg_product_image != blank -%}
          {%- assign sg_product_summary = product.description | strip_html | strip | truncate: 104 -%}
          <article class="sg-product-card">
            <div class="sg-product-card__media">
              <a class="sg-product-card__image-link" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {{ sg_product_image | image_url: width: 1000 | image_tag: class: 'sg-product-card__image', widths: '360, 540, 720, 1000', sizes: '(min-width: 1100px) 23vw, (min-width: 650px) 46vw, 92vw', loading: 'lazy', alt: product.title }}
              </a>
              <button
                class="sg-product-card__wishlist"
                type="button"
                data-sg-wishlist-toggle
                data-sg-wishlist-url="{{ sg_wishlist_url }}"
                data-product-id="{{ product.id }}"
                data-product-handle="{{ product.handle | escape }}"
                data-product-title="{{ product.title | escape }}"
                data-product-url="{{ product.url }}"
                data-product-image="{{ sg_product_image | image_url: width: 900 | escape }}"
                data-product-price="{{ product.price_min | money | strip_html | strip | escape }}"
                data-sg-label-add="Add {{ product.title | escape }} to wishlist"
                data-sg-label-remove="Remove {{ product.title | escape }} from wishlist"
                aria-label="Add {{ product.title | escape }} to wishlist"
                aria-pressed="false"
              >
                {% render 'sg-icon', name: 'heart' %}<span class="visually-hidden">Add to wishlist</span>
              </button>
            </div>
            <div class="sg-product-card__body">
              <div class="sg-product-card__text">
                <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                {%- if section.settings.show_descriptions and sg_product_summary != blank -%}<p class="sg-product-card__description">{{ sg_product_summary | escape }}</p>{%- endif -%}
              </div>
              {%- if section.settings.show_price and product.price_min != blank -%}<p class="sg-product-card__price"><span>{{ section.settings.price_prefix | escape }}</span> <strong>{{ product.price_min | money }}</strong></p>{%- endif -%}
              <div class="sg-product-card__actions">
                <a class="sg-button sg-button--outline sg-product-card__details" href="{{ product.url }}">{{ section.settings.details_label | escape }} {% render 'sg-icon', name: 'arrow' %}</a>
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if sg_featured_cards != blank -%}
  <section class="sg-section sg-products" id="sg-products-{{ section.id }}" {{ section.shopify_attributes }}>
    <div class="sg-shell-width">
      <header class="sg-section-heading">
        {%- if section.settings.eyebrow != blank -%}<p class="sg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.description != blank -%}<p class="sg-section-heading__description">{{ section.settings.description | escape }}</p>{%- endif -%}
      </header>
      <div class="sg-product-grid">{{ sg_featured_cards }}</div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="sg-section sg-products sg-products--editor-empty" id="sg-products-{{ section.id }}" {{ section.shopify_attributes }}>
    <div class="sg-shell-width">
      <header class="sg-section-heading">
        {%- if section.settings.eyebrow != blank -%}<p class="sg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </header>
      <div class="sg-product-editor-note" role="status">
        {%- if sg_featured_collection != blank -%}
          <strong>No storefront-ready products were returned for “{{ sg_featured_collection.title | escape }}”.</strong>
          <p>Shopify reports {{ sg_featured_collection.products_count }} products in this collection, but the preview returned none with a title, featured image, and Online Store URL. Confirm the products are Active, have a featured image, and are published to the Online Store sales channel.</p>
        {%- else -%}
          <strong>Select a product collection to show the product rail.</strong>
          <p>Choose a Shopify collection with products published to the Online Store sales channel.</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "SG · Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular Wedding Gifts" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "A few favourites to start your wishlist. Tap the heart to save any gift." },
    { "type": "collection", "id": "collection", "label": "Product collection", "info": "Choose a collection whose products are Active, have a featured image, and are published to the Online Store sales channel." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_descriptions", "label": "Show product descriptions", "default": false },
    { "type": "checkbox", "id": "show_price", "label": "Show indicative price", "default": true },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "Starting from" },
    { "type": "text", "id": "details_label", "label": "Product details link", "default": "View Details" },
    { "type": "url", "id": "wishlist_link", "label": "Wishlist page link" }
  ],
  "presets": [{ "name": "SG · Featured products" }]
}
{% endschema %}
