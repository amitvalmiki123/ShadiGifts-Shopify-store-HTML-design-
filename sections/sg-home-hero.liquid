{%- liquid
  assign sg_planner_link = section.settings.planner_link
  assign sg_wishlist_link = section.settings.wishlist_link
-%}
<section class="sg-home-hero" id="sg-home-hero-{{ section.id }}">
  <div class="sg-shell-width sg-home-hero__main">
    <div class="sg-home-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="sg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="sg-home-hero__title">{{ section.settings.heading_prefix | escape }} <em>{{ section.settings.heading_emphasis | escape }}</em></h1>
      {%- if section.settings.description != blank -%}<p class="sg-home-hero__lead">{{ section.settings.description | escape }}</p>{%- endif -%}
      <div class="sg-home-hero__actions">
        {%- if sg_planner_link != blank -%}
          <a class="sg-button sg-button--primary" href="{{ sg_planner_link }}">
            {% render 'sg-icon', name: 'gift' %}<span>{{ section.settings.primary_label | escape }}</span>{% render 'sg-icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if sg_wishlist_link != blank -%}
          <a class="sg-button sg-button--outline" href="{{ sg_wishlist_link }}">
            {% render 'sg-icon', name: 'heart' %}<span>{{ section.settings.secondary_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="sg-home-hero__media">
      <img
        class="sg-home-hero__image"
        src="{{ 'sg-home-hero.jpg' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="630"
        height="478"
        loading="eager"
        fetchpriority="high"
      >
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <div class="sg-shell-width sg-trust">
    <ul class="sg-trust__list" role="list">
      {%- for block in section.blocks -%}
        <li class="sg-trust__item" {{ block.shopify_attributes }}>
          <span class="sg-trust__icon">{% render 'sg-icon', name: block.settings.icon %}</span>
          <span>{{ block.settings.label | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "SG · Home hero",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "Trust point",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "box", "options": [
          { "value": "box", "label": "Curated gift" },
          { "value": "gift", "label": "Premium packaging" },
          { "value": "truck", "label": "Delivery" },
          { "value": "globe", "label": "Worldwide" }
        ] },
        { "type": "text", "id": "label", "label": "Benefit", "default": "Curated & Personalized Gifts" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "End-to-End Wedding Gifting" },
    { "type": "text", "id": "heading_prefix", "label": "Heading", "default": "Your Wedding. Every Gift." },
    { "type": "text", "id": "heading_emphasis", "label": "Emphasised heading", "default": "One Partner." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "We curate, personalize, package and deliver all your wedding gifts — on time, at your venue, anywhere in the world." },
    { "type": "text", "id": "image_alt", "label": "Hero image alt text", "default": "Wedding gift box with maroon satin bow, golden candle and flowers" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Plan My Wedding Gifting" },
    { "type": "url", "id": "planner_link", "label": "Planner page link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Create Wishlist" },
    { "type": "url", "id": "wishlist_link", "label": "Browse gifts to build a wishlist" }
  ],
  "presets": [
    { "name": "SG · Home hero", "blocks": [
      { "type": "benefit", "settings": { "icon": "box", "label": "Curated & Personalized Gifts" } },
      { "type": "benefit", "settings": { "icon": "gift", "label": "Premium Packaging" } },
      { "type": "benefit", "settings": { "icon": "truck", "label": "On-Time Delivery at Your Venue" } },
      { "type": "benefit", "settings": { "icon": "globe", "label": "For Indian & International Weddings" } }
    ] }
  ]
}
{% endschema %}
