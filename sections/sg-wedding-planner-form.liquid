<section class="sg-section sg-form-page sg-planner-form" id="sg-planner-form-{{ section.id }}">
  <div class="sg-shell-width sg-form-page__inner">
    <header class="sg-section-heading">
      {%- if section.settings.eyebrow != blank -%}<p class="sg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.description != blank -%}<p class="sg-section-heading__description">{{ section.settings.description | escape }}</p>{%- endif -%}
    </header>

    {% form 'contact', id: 'SGPlannerContactForm', class: 'sg-contact-form' %}
      {%- if form.posted_successfully? -%}
        <div class="sg-form-success" role="status" data-sg-contact-success>
          <span class="sg-form-success__icon" aria-hidden="true">✓</span>
          <h2>{{ section.settings.success_heading | escape }}</h2>
          <p>{{ section.settings.success_message | escape }}</p>
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="sg-form-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <input type="hidden" name="contact[subject]" value="{{ section.settings.email_subject | escape }}">
      <textarea class="sg-visually-hidden" name="contact[body]" tabindex="-1" aria-hidden="true" data-sg-planner-body></textarea>

      <div class="sg-form-card">
        <div class="sg-form-section-intro">
          <h2>{{ section.settings.wedding_section_heading | escape }}</h2>
          {%- if section.settings.wedding_section_description != blank -%}<p>{{ section.settings.wedding_section_description | escape }}</p>{%- endif -%}
        </div>
        <div class="sg-form-grid">
          <div class="sg-form-field">
            <label for="SGPlannerName-{{ section.id }}">{{ section.settings.name_label | escape }} <span aria-hidden="true">*</span></label>
            <input id="SGPlannerName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required>
          </div>
          <div class="sg-form-field">
            <label for="SGPlannerEmail-{{ section.id }}">{{ section.settings.email_label | escape }} <span aria-hidden="true">*</span></label>
            <input id="SGPlannerEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
          </div>
          <div class="sg-form-field">
            <label for="SGPlannerPhone-{{ section.id }}">{{ section.settings.phone_label | escape }}</label>
            <input id="SGPlannerPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel">
          </div>
          <div class="sg-form-field">
            <label for="SGPlannerCountry-{{ section.id }}">{{ section.settings.country_label | escape }}</label>
            <input id="SGPlannerCountry-{{ section.id }}" type="text" name="contact[Wedding country]" autocomplete="country-name">
          </div>
          <div class="sg-form-field">
            <label for="SGPlannerDate-{{ section.id }}">{{ section.settings.date_label | escape }}</label>
            <input id="SGPlannerDate-{{ section.id }}" type="date" name="contact[Wedding date]">
          </div>
          <div class="sg-form-field">
            <label for="SGPlannerLocation-{{ section.id }}">{{ section.settings.location_label | escape }}</label>
            <input id="SGPlannerLocation-{{ section.id }}" type="text" name="contact[Wedding location]" autocomplete="address-level2">
          </div>
          <div class="sg-form-field sg-form-field--full">
            <label for="SGPlannerGuests-{{ section.id }}">{{ section.settings.guests_label | escape }}</label>
            <input id="SGPlannerGuests-{{ section.id }}" type="number" name="contact[Approximate guest count]" min="1" inputmode="numeric">
          </div>
        </div>

        <fieldset class="sg-choice-group" data-sg-choice-group data-sg-min-one>
          <legend>{{ section.settings.functions_label | escape }}</legend>
          <div class="sg-choice-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'function' -%}
                {%- assign sg_function_value = block.settings.value | default: block.settings.label -%}
                <label class="sg-choice" for="SGPlannerFunction-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  <input id="SGPlannerFunction-{{ section.id }}-{{ block.id }}" type="checkbox" name="contact[Wedding functions][]" value="{{ sg_function_value | escape }}">
                  <span>{{ block.settings.label | escape }}</span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="sg-choice-group__error" data-sg-choice-error hidden>{{ section.settings.function_error | escape }}</span>
        </fieldset>
      </div>

      <div class="sg-form-card">
        <div class="sg-form-section-intro">
          <h2>{{ section.settings.needs_section_heading | escape }}</h2>
          {%- if section.settings.needs_section_description != blank -%}<p>{{ section.settings.needs_section_description | escape }}</p>{%- endif -%}
        </div>

        <fieldset class="sg-choice-group" data-sg-choice-group data-sg-min-one>
          <legend>{{ section.settings.needs_label | escape }}</legend>
          <div class="sg-choice-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'need' -%}
                {%- assign sg_need_value = block.settings.value | default: block.settings.label -%}
                <label class="sg-choice" for="SGPlannerNeed-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  <input id="SGPlannerNeed-{{ section.id }}-{{ block.id }}" type="checkbox" name="contact[Gifting needs][]" value="{{ sg_need_value | escape }}">
                  <span>{{ block.settings.label | escape }}</span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="sg-choice-group__error" data-sg-choice-error hidden>{{ section.settings.needs_error | escape }}</span>
        </fieldset>

        <fieldset class="sg-choice-group">
          <legend>{{ section.settings.extras_label | escape }}</legend>
          <div class="sg-choice-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'extra' -%}
                {%- assign sg_extra_value = block.settings.value | default: block.settings.label -%}
                <label class="sg-choice" for="SGPlannerExtra-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  <input id="SGPlannerExtra-{{ section.id }}-{{ block.id }}" type="checkbox" name="contact[Additional services][]" value="{{ sg_extra_value | escape }}">
                  <span>{{ block.settings.label | escape }}</span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>

        <div class="sg-form-grid">
          <div class="sg-form-field">
            <label for="SGPlannerDeliverBy-{{ section.id }}">{{ section.settings.delivery_date_label | escape }}</label>
            <input id="SGPlannerDeliverBy-{{ section.id }}" type="date" name="contact[Delivery needed by]">
          </div>
          <div class="sg-form-field">
            <label for="SGPlannerTotalBudget-{{ section.id }}">{{ section.settings.total_budget_label | escape }}</label>
            <input id="SGPlannerTotalBudget-{{ section.id }}" type="text" name="contact[Total budget]">
          </div>
        </div>

        <fieldset class="sg-choice-group" data-sg-choice-group data-sg-min-one>
          <legend>{{ section.settings.budget_label | escape }}</legend>
          <div class="sg-choice-grid sg-choice-grid--budget">
            {%- for block in section.blocks -%}
              {%- if block.type == 'budget' -%}
                {%- assign sg_budget_value = block.settings.value | default: block.settings.label -%}
                <label class="sg-choice" for="SGPlannerBudget-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  <input id="SGPlannerBudget-{{ section.id }}-{{ block.id }}" type="radio" name="contact[Budget per gift]" value="{{ sg_budget_value | escape }}">
                  <span>{{ block.settings.label | escape }}</span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="sg-choice-group__error" data-sg-choice-error hidden>{{ section.settings.budget_error | escape }}</span>
        </fieldset>

        <div class="sg-form-grid">
          <div class="sg-form-field sg-form-field--full">
            <label for="SGPlannerTheme-{{ section.id }}">{{ section.settings.theme_label | escape }}</label>
            <input id="SGPlannerTheme-{{ section.id }}" type="text" name="contact[Wedding theme and colours]">
          </div>
          <div class="sg-form-field sg-form-field--full">
            <label for="SGPlannerNotes-{{ section.id }}">{{ section.settings.notes_label | escape }}</label>
            <textarea id="SGPlannerNotes-{{ section.id }}" name="contact[Additional notes]" rows="4"></textarea>
          </div>
        </div>
        {%- if section.settings.form_note != blank -%}<p class="sg-form-note">{{ section.settings.form_note | escape }}</p>{%- endif -%}
      </div>

      <div class="sg-form-submit">
        <button class="sg-button sg-button--primary" type="submit">{{ section.settings.submit_label | escape }} {% render 'sg-icon', name: 'arrow' %}</button>
        <p>{{ section.settings.privacy_note | escape }}</p>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "SG · Planner form",
  "max_blocks": 50,
  "blocks": [
    { "type": "function", "name": "Wedding function", "settings": [
      { "type": "text", "id": "label", "label": "Option label", "default": "Wedding" },
      { "type": "text", "id": "value", "label": "Submitted value", "info": "Leave blank to submit the option label." }
    ] },
    { "type": "need", "name": "Gifting need", "settings": [
      { "type": "text", "id": "label", "label": "Option label", "default": "Return gifts" },
      { "type": "text", "id": "value", "label": "Submitted value", "info": "Leave blank to submit the option label." }
    ] },
    { "type": "extra", "name": "Extra service", "settings": [
      { "type": "text", "id": "label", "label": "Option label", "default": "Personalisation" },
      { "type": "text", "id": "value", "label": "Submitted value", "info": "Leave blank to submit the option label." }
    ] },
    { "type": "budget", "name": "Budget option", "settings": [
      { "type": "text", "id": "label", "label": "Option label", "default": "Not sure yet" },
      { "type": "text", "id": "value", "label": "Submitted value", "info": "Leave blank to submit the option label." }
    ] }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wedding gifting concierge" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Plan Your Wedding Gifting" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Tell us about your wedding and the gifts you have in mind. Our team will email you a personalised proposal." },
    { "type": "text", "id": "email_subject", "label": "Email subject", "default": "Wedding gifting planner enquiry" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Thank you — your plan is submitted" },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Our gifting team will review your details and email you a personalised proposal shortly." },
    { "type": "text", "id": "wedding_section_heading", "label": "Wedding details heading", "default": "Your Wedding Details" },
    { "type": "textarea", "id": "wedding_section_description", "label": "Wedding details description", "default": "Share your contact details, wedding date and destination." },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Your name" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email address" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone / WhatsApp" },
    { "type": "text", "id": "country_label", "label": "Country label", "default": "Wedding country" },
    { "type": "text", "id": "date_label", "label": "Wedding date label", "default": "Wedding date" },
    { "type": "text", "id": "location_label", "label": "Location label", "default": "Wedding location (city / venue)" },
    { "type": "text", "id": "guests_label", "label": "Guest count label", "default": "Approximate number of guests" },
    { "type": "text", "id": "functions_label", "label": "Functions label", "default": "Wedding functions" },
    { "type": "text", "id": "function_error", "label": "Functions error message", "default": "Choose at least one wedding function." },
    { "type": "text", "id": "needs_section_heading", "label": "Gifting needs heading", "default": "Your Gifting Needs" },
    { "type": "textarea", "id": "needs_section_description", "label": "Gifting needs description", "default": "Select the gifts and services you would like us to consider." },
    { "type": "text", "id": "needs_label", "label": "Needs label", "default": "What do you need?" },
    { "type": "text", "id": "needs_error", "label": "Needs error message", "default": "Choose at least one gifting need." },
    { "type": "text", "id": "extras_label", "label": "Extra services label", "default": "Extra services" },
    { "type": "text", "id": "delivery_date_label", "label": "Delivery date label", "default": "Delivery needed by" },
    { "type": "text", "id": "total_budget_label", "label": "Total budget label", "default": "Total budget (optional)" },
    { "type": "text", "id": "budget_label", "label": "Budget per gift label", "default": "Approximate budget per gift" },
    { "type": "text", "id": "budget_error", "label": "Budget error message", "default": "Choose a budget range or add a budget option in the theme editor." },
    { "type": "text", "id": "theme_label", "label": "Theme label", "default": "Theme, colours or style" },
    { "type": "text", "id": "notes_label", "label": "Notes label", "default": "Anything else we should know?" },
    { "type": "textarea", "id": "form_note", "label": "Form note", "default": "Indicative only. Your final proposal depends on quantity, personalisation and packaging." },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Submit My Gifting Plan" },
    { "type": "textarea", "id": "privacy_note", "label": "Privacy note", "default": "Your details are sent directly to our Shopify contact inbox so our team can follow up with your proposal." }
  ],
  "presets": [{ "name": "SG · Planner form", "blocks": [
    { "type": "function", "settings": { "label": "Ring Ceremony" } },
    { "type": "function", "settings": { "label": "Haldi" } },
    { "type": "function", "settings": { "label": "Mehendi" } },
    { "type": "function", "settings": { "label": "Sangeet" } },
    { "type": "function", "settings": { "label": "Wedding" } },
    { "type": "function", "settings": { "label": "Reception" } },
    { "type": "need", "settings": { "label": "Return gifts" } },
    { "type": "need", "settings": { "label": "Welcome hampers" } },
    { "type": "need", "settings": { "label": "VIP & family gifts" } },
    { "type": "need", "settings": { "label": "Bridal party gifts" } },
    { "type": "need", "settings": { "label": "Function gifts" } },
    { "type": "need", "settings": { "label": "Trousseau packing" } },
    { "type": "extra", "settings": { "label": "Personalisation" } },
    { "type": "extra", "settings": { "label": "Premium packaging" } },
    { "type": "extra", "settings": { "label": "Venue delivery" } },
    { "type": "extra", "settings": { "label": "International delivery" } },
    { "type": "budget", "settings": { "label": "₹100 – ₹999", "value": "100-999" } },
    { "type": "budget", "settings": { "label": "₹1,000 – ₹2,000", "value": "1000-2000" } },
    { "type": "budget", "settings": { "label": "₹2,000 – ₹3,000", "value": "2000-3000" } },
    { "type": "budget", "settings": { "label": "₹3,000 & above", "value": "3000+" } },
    { "type": "budget", "settings": { "label": "Not sure yet", "value": "Not sure" } }
  ] }]
}
{% endschema %}
