{%- liquid
  assign sg_phone_digits = section.settings.phone_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
-%}
<div class="sg-topbar" {{ section.shopify_attributes }}>
  <div class="sg-shell-width sg-topbar__inner">
    <ul class="sg-topbar__items sg-topbar__items--left" role="list">
      <li class="sg-topbar__item">
        {% render 'sg-icon', name: 'globe-small' %}
        <span>{{ section.settings.serving_text | escape }}</span>
      </li>
      <li class="sg-topbar__item">
        {% render 'sg-icon', name: 'plane' %}
        <span>{{ section.settings.delivery_text | escape }}</span>
      </li>
      <li class="sg-topbar__item">
        {% render 'sg-icon', name: 'shield' %}
        <span>{{ section.settings.quality_text | escape }}</span>
      </li>
    </ul>

    <ul class="sg-topbar__items sg-topbar__items--right" role="list">
      <li class="sg-topbar__item sg-topbar__item--whatsapp">
        <a href="https://wa.me/{{ sg_phone_digits | escape }}" target="_blank" rel="noopener noreferrer">
          {% render 'sg-icon', name: 'whatsapp' %}
          <span>{{ section.settings.whatsapp_label | escape }}</span>
        </a>
      </li>
      <li class="sg-topbar__item">
        <a href="tel:+{{ sg_phone_digits | escape }}">
          {% render 'sg-icon', name: 'phone' %}
          <span>{{ section.settings.phone_display | escape }}</span>
        </a>
      </li>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "SG · Top information bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    { "type": "text", "id": "serving_text", "label": "Service area", "default": "Serving India & Worldwide" },
    { "type": "text", "id": "delivery_text", "label": "Delivery assurance", "default": "International Delivery" },
    { "type": "text", "id": "quality_text", "label": "Quality assurance", "default": "Quality Assured" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp link label", "default": "Chat on WhatsApp" },
    { "type": "text", "id": "phone_display", "label": "Phone number shown", "default": "+91 98765 43210" },
    { "type": "text", "id": "phone_number", "label": "Phone number for links (country code and digits)", "default": "919876543210" }
  ],
  "presets": [
    { "name": "SG · Top information bar" }
  ]
}
{% endschema %}
