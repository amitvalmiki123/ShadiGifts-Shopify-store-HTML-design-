<section class="sg-section sg-section--band sg-why" id="sg-why-{{ section.id }}">
  <div class="sg-shell-width">
    <header class="sg-section-heading">
      {%- if section.settings.eyebrow != blank -%}<p class="sg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.description != blank -%}<p class="sg-section-heading__description">{{ section.settings.description | escape }}</p>{%- endif -%}
    </header>
    <div class="sg-benefit-grid">
      {%- for block in section.blocks -%}
        <article class="sg-benefit-card" {{ block.shopify_attributes }}>
          <span class="sg-benefit-card__icon">{% render 'sg-icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.description | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SG · Why choose us",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "box", "options": [
          { "value": "box", "label": "Curated gifts" },
          { "value": "pen", "label": "Personalisation" },
          { "value": "gift", "label": "Packaging" },
          { "value": "truck", "label": "Delivery" },
          { "value": "support", "label": "Concierge support" },
          { "value": "globe", "label": "Worldwide" }
        ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtfully curated" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Gifts selected for quality, theme and the people who will receive them." }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Couples Choose ShaadiGifts" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "One concierge instead of many vendors — so nothing is missed between the first function and the last guest." }
  ],
  "presets": [{ "name": "SG · Why choose us", "blocks": [
    { "type": "benefit", "settings": { "icon": "box", "heading": "Curated, Not Catalogued", "description": "Every gift is handpicked for quality, theme and the guest who will receive it — from return gifts to VIP presents." } },
    { "type": "benefit", "settings": { "icon": "pen", "heading": "Personalised To Your Story", "description": "Names, monograms, custom tags, message cards and colour-matched ribbons, carried through every box." } },
    { "type": "benefit", "settings": { "icon": "gift", "heading": "Premium Packaging", "description": "Elegant, theme-based packaging that feels like a keepsake and arrives looking exactly as it should." } },
    { "type": "benefit", "settings": { "icon": "truck", "heading": "On-Time, At Your Venue", "description": "We plan delivery around your function schedule and deliver to your home, hotel or wedding venue." } },
    { "type": "benefit", "settings": { "icon": "support", "heading": "One Point Of Contact", "description": "A dedicated wedding concierge handles planning, updates and coordination, so you are not chasing suppliers." } },
    { "type": "benefit", "settings": { "icon": "globe", "heading": "India & Worldwide", "description": "Weddings in Jaipur, Dubai or Bangkok get the same care. We deliver across India and internationally." } }
  ] }]
}
{% endschema %}
