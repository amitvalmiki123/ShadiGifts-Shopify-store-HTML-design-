<div class="sg-footer-brand" {{ block.shopify_attributes }}>
  <a class="sg-footer-brand__logo-link sg-footer-brand__logo-link--custom" href="{{ routes.root_url }}" aria-label="ShaadiGifts — The Wedding Gifting Concierge home">
    <img class="sg-footer-brand__logo-icon" src="{{ 'sg-logo-footer-icon.svg' | asset_url }}" alt="" width="46" height="34" loading="lazy">
    <span class="sg-footer-brand__copy">
      <span class="sg-footer-brand__wordmark">ShaadiGifts</span>
      <small class="sg-footer-brand__tagline">The Wedding Gifting Concierge</small>
    </span>
  </a>

  {%- if block.settings.description != blank -%}
    <p class="sg-footer-brand__description">{{ block.settings.description | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "ShaadiGifts footer brand",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays the approved gold three-ellipse mark with the ShaadiGifts wordmark and concierge tagline."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We curate, personalize, package and deliver your wedding gifts — on time, at your venue, anywhere in the world."
    }
  ]
}
{% endschema %}
