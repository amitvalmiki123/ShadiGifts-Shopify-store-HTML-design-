{%- liquid
  assign sg_footer_menu = block.settings.menu
  assign sg_footer_collection_links = blank
  if sg_footer_menu != blank
    assign sg_footer_collection_links = sg_footer_menu.links
    for sg_footer_menu_link in sg_footer_menu.links
      assign sg_link_title = sg_footer_menu_link.title | downcase | strip
      if sg_link_title == 'collections' and sg_footer_menu_link.links != blank
        assign sg_footer_collection_links = sg_footer_menu_link.links
        break
      endif
    endfor
  endif
-%}

{%- if sg_footer_collection_links != blank -%}
  <div class="sg-footer-collections" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h3 class="sg-footer-collections__heading">{{ block.settings.heading | escape }}</h3>
    {%- endif -%}
    <ul class="sg-footer-collections__list" role="list">
      {%- for sg_footer_collection_link in sg_footer_collection_links -%}
        <li><a href="{{ sg_footer_collection_link.url }}">{{ sg_footer_collection_link.title | escape }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Footer collections",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}
