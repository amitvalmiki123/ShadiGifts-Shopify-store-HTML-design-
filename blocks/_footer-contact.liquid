{%- liquid
  assign sg_phone_display = block.settings.phone_number | strip
  assign sg_phone_digits = sg_phone_display | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign sg_email = block.settings.email_address | strip
  assign sg_whatsapp_digits = block.settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
-%}

<div class="sg-footer-contact" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h3 class="sg-footer-contact__heading">{{ block.settings.heading | escape }}</h3>
  {%- endif -%}

  <ul class="sg-footer-contact__list" role="list">
    {%- if sg_phone_digits != blank -%}
      <li><a href="tel:+{{ sg_phone_digits | escape }}">{{ sg_phone_display | escape }}</a></li>
    {%- endif -%}

    {%- if sg_email != blank -%}
      <li><a href="mailto:{{ sg_email | escape }}">{{ sg_email | escape }}</a></li>
    {%- endif -%}

    {%- if sg_whatsapp_digits != blank and block.settings.whatsapp_label != blank -%}
      <li>
        <a href="https://wa.me/{{ sg_whatsapp_digits | escape }}" target="_blank" rel="noopener noreferrer">
          {{ block.settings.whatsapp_label | escape }}
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.wishlist_link != blank and block.settings.wishlist_label != blank -%}
      <li>
        <a href="{{ block.settings.wishlist_link | escape }}">
          {{ block.settings.wishlist_label | escape }}
          {%- if block.settings.show_wishlist_count -%}
            (<span data-sg-wishlist-count>0</span>)
          {%- endif -%}
        </a>
      </li>
    {%- endif -%}
  </ul>

  {%- if block.settings.explanatory_text != blank -%}
    <p class="sg-footer-contact__note">{{ block.settings.explanatory_text | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Get in Touch",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in Touch" },
    { "type": "text", "id": "phone_number", "label": "Phone number", "info": "Leave blank until you have a verified number." },
    { "type": "text", "id": "email_address", "label": "Email address", "info": "Leave blank until you have a verified email address." },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (country code and digits)", "info": "Leave blank until you have a verified WhatsApp number." },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp link label", "default": "Chat on WhatsApp", "visible_if": "{{ block.settings.whatsapp_number != blank }}" },
    { "type": "text", "id": "wishlist_label", "label": "Wishlist link label", "default": "My Wishlist", "visible_if": "{{ block.settings.wishlist_link != blank }}" },
    { "type": "url", "id": "wishlist_link", "label": "Wishlist page", "visible_if": "{{ block.settings.wishlist_label != blank }}" },
    { "type": "checkbox", "id": "show_wishlist_count", "label": "Show wishlist count", "default": true, "visible_if": "{{ block.settings.wishlist_link != blank }}" },
    { "type": "textarea", "id": "explanatory_text", "label": "Explanatory text", "default": "Gifts are not sold online — build a wishlist and request a personalised proposal." }
  ]
}
{% endschema %}
